{
  "expo": {
    "name": "clwy-app",
    "slug": "clwy-app",
    "version": "1.0.0",
    "scheme": "clwy-app",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.clwyapp"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-web-browser", "expo-video", "expo-secure-store"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d4cdfb4-e161-464d-918e-d5bdaaf0a580"
      }
    }
  }
}
